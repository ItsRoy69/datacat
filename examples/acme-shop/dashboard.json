{
  "title": "Acme Shop \u00b7 Checkout Health",
  "description": "Live view of the Acme shop microservices (gateway, catalog, cart, payments, order worker).",
  "layout_type": "ordered",
  "template_variables": [
    {
      "name": "env",
      "prefix": "env",
      "default": "prod"
    },
    {
      "name": "service",
      "prefix": "service",
      "default": "*"
    }
  ],
  "widgets": [
    {
      "definition": {
        "type": "group",
        "title": "Overview \u00b7 checkout reliability and revenue",
        "layout_type": "ordered",
        "background_color": "vivid_purple",
        "widgets": [
          {
            "definition": {
              "type": "query_value",
              "title": "Checkouts / min",
              "precision": 1,
              "custom_unit": null,
              "requests": [
                {
                  "queries": [
                    {
                      "name": "a",
                      "data_source": "metrics",
                      "query": "sum:acme.checkout.completed{$env}",
                      "aggregator": "avg"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "a * 60",
                      "alias": "completed"
                    }
                  ],
                  "response_format": "scalar"
                }
              ]
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 3,
              "height": 1
            }
          },
          {
            "definition": {
              "type": "query_value",
              "title": "Checkout failure rate",
              "precision": 2,
              "custom_unit": "%",
              "requests": [
                {
                  "queries": [
                    {
                      "name": "a",
                      "data_source": "metrics",
                      "query": "sum:acme.checkout.completed{$env}",
                      "aggregator": "avg"
                    },
                    {
                      "name": "b",
                      "data_source": "metrics",
                      "query": "sum:acme.checkout.failed{$env}",
                      "aggregator": "avg"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "b / (a + b) * 100",
                      "alias": "failure rate"
                    }
                  ],
                  "response_format": "scalar",
                  "conditional_formats": [
                    {
                      "comparator": ">",
                      "value": 10,
                      "palette": "red_on_white"
                    },
                    {
                      "comparator": ">",
                      "value": 4,
                      "palette": "yellow_on_white"
                    },
                    {
                      "comparator": "<=",
                      "value": 4,
                      "palette": "green_on_white"
                    }
                  ]
                }
              ]
            },
            "layout": {
              "x": 3,
              "y": 0,
              "width": 3,
              "height": 1
            }
          },
          {
            "definition": {
              "type": "query_value",
              "title": "Avg order value",
              "precision": 2,
              "custom_unit": "USD",
              "requests": [
                {
                  "queries": [
                    {
                      "name": "a",
                      "data_source": "metrics",
                      "query": "avg:acme.checkout.value.avg{$env}",
                      "aggregator": "avg"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "a"
                    }
                  ],
                  "response_format": "scalar"
                }
              ]
            },
            "layout": {
              "x": 6,
              "y": 0,
              "width": 3,
              "height": 1
            }
          },
          {
            "definition": {
              "type": "query_value",
              "title": "Revenue / min",
              "precision": 0,
              "custom_unit": "USD",
              "requests": [
                {
                  "queries": [
                    {
                      "name": "a",
                      "data_source": "metrics",
                      "query": "sum:acme.checkout.value.sum{$env}",
                      "aggregator": "avg"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "a * 6"
                    }
                  ],
                  "response_format": "scalar"
                }
              ]
            },
            "layout": {
              "x": 9,
              "y": 0,
              "width": 3,
              "height": 1
            }
          },
          {
            "definition": {
              "type": "query_value",
              "title": "Fulfillment queue",
              "precision": 0,
              "custom_unit": null,
              "requests": [
                {
                  "queries": [
                    {
                      "name": "a",
                      "data_source": "metrics",
                      "query": "max:acme.queue.depth{$env}",
                      "aggregator": "last"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "a"
                    }
                  ],
                  "response_format": "scalar",
                  "conditional_formats": [
                    {
                      "comparator": ">",
                      "value": 15,
                      "palette": "white_on_red"
                    },
                    {
                      "comparator": ">",
                      "value": 10,
                      "palette": "white_on_yellow"
                    },
                    {
                      "comparator": "<=",
                      "value": 10,
                      "palette": "white_on_green"
                    }
                  ]
                }
              ]
            },
            "layout": {
              "x": 0,
              "y": 1,
              "width": 3,
              "height": 1
            }
          },
          {
            "definition": {
              "type": "query_value",
              "title": "Orders shipped / min",
              "precision": 1,
              "custom_unit": null,
              "requests": [
                {
                  "queries": [
                    {
                      "name": "a",
                      "data_source": "metrics",
                      "query": "sum:acme.orders.fulfilled{$env}",
                      "aggregator": "avg"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "a * 60"
                    }
                  ],
                  "response_format": "scalar"
                }
              ]
            },
            "layout": {
              "x": 3,
              "y": 1,
              "width": 3,
              "height": 1
            }
          },
          {
            "definition": {
              "type": "query_value",
              "title": "Gateway requests",
              "precision": 0,
              "custom_unit": null,
              "requests": [
                {
                  "queries": [
                    {
                      "name": "a",
                      "data_source": "metrics",
                      "query": "sum:trace.http.server.request.hits{$env,service:web-gateway}",
                      "aggregator": "sum"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "a"
                    }
                  ],
                  "response_format": "scalar"
                }
              ]
            },
            "layout": {
              "x": 6,
              "y": 1,
              "width": 3,
              "height": 1
            }
          },
          {
            "definition": {
              "type": "query_value",
              "title": "Checkout latency",
              "precision": 0,
              "custom_unit": "ms",
              "requests": [
                {
                  "queries": [
                    {
                      "name": "a",
                      "data_source": "metrics",
                      "query": "avg:trace.http.server.request.duration{$env,service:web-gateway,resource_name:post_/checkout}",
                      "aggregator": "avg"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "a * 1000"
                    }
                  ],
                  "response_format": "scalar",
                  "conditional_formats": [
                    {
                      "comparator": ">",
                      "value": 250,
                      "palette": "red_on_white"
                    },
                    {
                      "comparator": ">",
                      "value": 150,
                      "palette": "yellow_on_white"
                    },
                    {
                      "comparator": "<=",
                      "value": 150,
                      "palette": "green_on_white"
                    }
                  ]
                }
              ]
            },
            "layout": {
              "x": 9,
              "y": 1,
              "width": 3,
              "height": 1
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Checkouts completed vs failed (per min)",
              "show_legend": true,
              "requests": [
                {
                  "queries": [
                    {
                      "name": "a",
                      "data_source": "metrics",
                      "query": "sum:acme.checkout.completed{$env}"
                    },
                    {
                      "name": "b",
                      "data_source": "metrics",
                      "query": "sum:acme.checkout.failed{$env}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "a * 60",
                      "alias": "completed"
                    },
                    {
                      "formula": "b * 60",
                      "alias": "failed"
                    }
                  ],
                  "response_format": "timeseries",
                  "display_type": "bars",
                  "style": {
                    "palette": "classic"
                  }
                }
              ]
            },
            "layout": {
              "x": 0,
              "y": 2,
              "width": 6,
              "height": 3
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Checkout latency (ms)",
              "show_legend": false,
              "requests": [
                {
                  "queries": [
                    {
                      "name": "a",
                      "data_source": "metrics",
                      "query": "avg:trace.http.server.request.duration{$env,service:web-gateway,resource_name:post_/checkout}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "a * 1000"
                    }
                  ],
                  "response_format": "timeseries",
                  "display_type": "line",
                  "style": {
                    "palette": "warm"
                  }
                }
              ],
              "markers": [
                {
                  "value": "y = 250",
                  "display_type": "error dashed",
                  "label": "SLO"
                }
              ]
            },
            "layout": {
              "x": 6,
              "y": 2,
              "width": 6,
              "height": 3
            }
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 0,
        "width": 12,
        "height": 6
      }
    },
    {
      "definition": {
        "type": "group",
        "title": "Services",
        "layout_type": "ordered",
        "background_color": "vivid_blue",
        "widgets": [
          {
            "definition": {
              "type": "timeseries",
              "title": "Requests by service",
              "show_legend": true,
              "requests": [
                {
                  "queries": [
                    {
                      "name": "a",
                      "data_source": "metrics",
                      "query": "sum:trace.http.server.request.hits{$env,$service} by {service}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "a"
                    }
                  ],
                  "response_format": "timeseries",
                  "display_type": "bars",
                  "style": {
                    "palette": "classic"
                  }
                }
              ]
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 6,
              "height": 3
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Errors by service",
              "show_legend": true,
              "requests": [
                {
                  "queries": [
                    {
                      "name": "a",
                      "data_source": "metrics",
                      "query": "sum:trace.http.server.request.errors{$env,$service} by {service}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "a"
                    }
                  ],
                  "response_format": "timeseries",
                  "display_type": "bars",
                  "style": {
                    "palette": "warm"
                  }
                }
              ]
            },
            "layout": {
              "x": 6,
              "y": 0,
              "width": 6,
              "height": 3
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Latency by service (ms)",
              "show_legend": true,
              "requests": [
                {
                  "queries": [
                    {
                      "name": "a",
                      "data_source": "metrics",
                      "query": "avg:trace.http.server.request.duration{$env,$service} by {service}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "a * 1000"
                    }
                  ],
                  "response_format": "timeseries",
                  "display_type": "line",
                  "style": {
                    "palette": "classic"
                  }
                }
              ]
            },
            "layout": {
              "x": 0,
              "y": 3,
              "width": 6,
              "height": 3
            }
          },
          {
            "definition": {
              "type": "toplist",
              "title": "Slowest endpoints (avg ms)",
              "requests": [
                {
                  "queries": [
                    {
                      "name": "a",
                      "data_source": "metrics",
                      "query": "avg:trace.http.server.request.duration{$env,$service} by {resource_name}",
                      "aggregator": "avg"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "a * 1000"
                    }
                  ],
                  "response_format": "scalar",
                  "limit": 8
                }
              ]
            },
            "layout": {
              "x": 6,
              "y": 3,
              "width": 6,
              "height": 3
            }
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 6,
        "width": 12,
        "height": 7
      }
    },
    {
      "definition": {
        "type": "group",
        "title": "Checkout",
        "layout_type": "ordered",
        "background_color": "vivid_orange",
        "widgets": [
          {
            "definition": {
              "type": "timeseries",
              "title": "Failed checkouts by reason (per min)",
              "show_legend": true,
              "requests": [
                {
                  "queries": [
                    {
                      "name": "a",
                      "data_source": "metrics",
                      "query": "sum:acme.checkout.failed{$env} by {reason}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "a * 60",
                      "alias": "failed"
                    }
                  ],
                  "response_format": "timeseries",
                  "display_type": "bars",
                  "style": {
                    "palette": "warm"
                  }
                }
              ]
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 6,
              "height": 3
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Order value (USD)",
              "show_legend": true,
              "requests": [
                {
                  "queries": [
                    {
                      "name": "a",
                      "data_source": "metrics",
                      "query": "avg:acme.checkout.value.median{$env}"
                    },
                    {
                      "name": "b",
                      "data_source": "metrics",
                      "query": "avg:acme.checkout.value.95percentile{$env}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "a",
                      "alias": "median"
                    },
                    {
                      "formula": "b",
                      "alias": "p95"
                    }
                  ],
                  "response_format": "timeseries",
                  "display_type": "line",
                  "style": {
                    "palette": "classic"
                  }
                }
              ]
            },
            "layout": {
              "x": 6,
              "y": 0,
              "width": 6,
              "height": 3
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Checkouts by plan (per min)",
              "show_legend": true,
              "requests": [
                {
                  "queries": [
                    {
                      "name": "a",
                      "data_source": "metrics",
                      "query": "sum:acme.checkout.completed{$env} by {plan}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "a * 60",
                      "alias": "completed"
                    }
                  ],
                  "response_format": "timeseries",
                  "display_type": "area",
                  "style": {
                    "palette": "cool"
                  }
                }
              ]
            },
            "layout": {
              "x": 0,
              "y": 3,
              "width": 6,
              "height": 3
            }
          },
          {
            "definition": {
              "type": "list_stream",
              "title": "Checkout and payment errors",
              "requests": [
                {
                  "response_format": "event_list",
                  "query": {
                    "data_source": "logs_stream",
                    "query_string": "status:error"
                  }
                }
              ]
            },
            "layout": {
              "x": 6,
              "y": 3,
              "width": 6,
              "height": 3
            }
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 13,
        "width": 12,
        "height": 7
      }
    },
    {
      "definition": {
        "type": "group",
        "title": "Fulfillment",
        "layout_type": "ordered",
        "background_color": "vivid_green",
        "widgets": [
          {
            "definition": {
              "type": "timeseries",
              "title": "Fulfillment queue depth",
              "show_legend": false,
              "requests": [
                {
                  "queries": [
                    {
                      "name": "a",
                      "data_source": "metrics",
                      "query": "max:acme.queue.depth{$env}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "a"
                    }
                  ],
                  "response_format": "timeseries",
                  "display_type": "line",
                  "style": {
                    "palette": "purple"
                  }
                }
              ],
              "markers": [
                {
                  "value": "y = 15",
                  "display_type": "error dashed",
                  "label": "alert"
                },
                {
                  "value": "y = 10",
                  "display_type": "warning dashed",
                  "label": "warn"
                }
              ]
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 6,
              "height": 3
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Fulfillment duration (ms)",
              "show_legend": true,
              "requests": [
                {
                  "queries": [
                    {
                      "name": "a",
                      "data_source": "metrics",
                      "query": "avg:acme.fulfillment.duration.avg{$env}"
                    },
                    {
                      "name": "b",
                      "data_source": "metrics",
                      "query": "avg:acme.fulfillment.duration.95percentile{$env}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "a * 1000",
                      "alias": "avg"
                    },
                    {
                      "formula": "b * 1000",
                      "alias": "p95"
                    }
                  ],
                  "response_format": "timeseries",
                  "display_type": "line",
                  "style": {
                    "palette": "classic"
                  }
                }
              ]
            },
            "layout": {
              "x": 6,
              "y": 0,
              "width": 6,
              "height": 3
            }
          },
          {
            "definition": {
              "type": "manage_status",
              "title": "Shop monitors",
              "query": "",
              "summary_type": "monitors"
            },
            "layout": {
              "x": 0,
              "y": 3,
              "width": 12,
              "height": 2
            }
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 20,
        "width": 12,
        "height": 6
      }
    }
  ]
}
